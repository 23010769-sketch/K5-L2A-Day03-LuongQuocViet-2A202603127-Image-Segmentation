# Documentation only; set these in PowerShell. This file is NOT loaded automatically.
# Confirm school permission before changing either policy flag.
CVAT_API_ALLOWED=0
LOCAL_MODELS_ALLOWED=0
CVAT_HOST=https://app.cvat.ai
CVAT_ACCESS_TOKEN=replace-with-your-personal-access-token
# Empty for personal workspace; organization slug otherwise.
CVAT_ORG=
# Required separately for reading annotations during an approved write/verification.
CVAT_ANNOTATION_READ_ALLOWED=0
# Write stays disabled until school permission AND per-batch user confirmation.
CVAT_WRITE_ALLOWED=0
